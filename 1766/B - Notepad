#include <iostream>
#include <unordered_map>
#include <string>
using namespace std;
 
int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        string s;
        cin >> s;
 
        unordered_map<string, int> cur;
        int result = 0;
 
        for (int i = 0; i < n - 1; ++i) {
            string t = s.substr(i, 2);
            if (cur.find(t) != cur.end()) {
                if (cur[t] < i - 1) {
                    result = 1;
                    break;
                }
            } else {
                cur[t] = i;
            }
        }
 
        if (result == 1) {
            cout << "YES" << endl;
        } else {
            cout << "NO" << endl;
        }
    }
 
    return 0;
}